pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
  }

  parameters {
    string(name: 'GITHUB_CREDENTIAL', defaultValue: 'github_cred', description: 'Github access credentials id')
    string(name: 'GITHUB_BRANCH', defaultValue: 'main', description: 'Branch to build from')
    string(name: 'GITHUB_REPO_URL', defaultValue: 'https://github.com/ogob31/magvector_project.git', description: 'Repository URL to build from')
    string(name: 'VERSION', defaultValue: "V00${BUILD_ID}", description: 'Version of Docker image to be built, e.g., V001')
    string(name: 'TASK_DEF_JSON', defaultValue: 'continuous-integration-continuous-deployment/task-def.json', description: 'Path to the task definition JSON file')
    string(name: 'CREATE_SERVICE_FILE', defaultValue: 'continuous-integration-continuous-deployment/create-ecs-service.json', description: 'Path to the create service JSON file')
    string(name: 'UPDATE_SERVICE_FILE', defaultValue: 'continuous-integration-continuous-deployment/update-ecs-service.json', description: 'Path to the update service JSON file')
    string(name: 'SERVICE_NAME', defaultValue: 'magvector-service', description: 'ECS Service Name')
    string(name: 'ECS_CLUSTER_NAME', defaultValue: 'magvector-cluster', description: 'ECS Cluster Name')
  }

  environment {
    AWS_REGION         = "eu-central-1"
    AWS_DEFAULT_REGION = "eu-central-1"
    AWS_ACCOUNT_ID     = "051826742726"
    ECR_REPO           = "magvector-app"
    ECR_REGISTRY       = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    DOCKER_IMAGE_LOCAL = "test-app-html-image"
  }

  stages {
    stage('Clean Workspace') {
      steps {
        cleanWs()
      }
    }

    stage('Clone GitHub Repo') {
      steps {
        git branch: "${params.GITHUB_BRANCH}",
            credentialsId: "${params.GITHUB_CREDENTIAL}",
            url: "${params.GITHUB_REPO_URL}"
      }
    }

    stage('Preflight (AWS)') {
      steps {
        sh '''
          set -euo pipefail
          aws --version
          aws sts get-caller-identity
          aws ecr get-login-password --region "$AWS_REGION" >/dev/null
          aws ecr describe-repositories --region "$AWS_REGION" --repository-names "$ECR_REPO" >/dev/null
          python3 --version
        '''
      }
    }

    stage('Build Docker Image') {
      steps {
        sh '''
          set -euo pipefail
          docker build -t "$DOCKER_IMAGE_LOCAL" .
        '''
      }
    }

    stage('Push To ECR (eu-central-1)') {
      steps {
        script {
          def fullImage = "${env.ECR_REGISTRY}/${env.ECR_REPO}:${params.VERSION}"

          sh """
            set -euo pipefail
            aws ecr get-login-password --region "${AWS_REGION}" | docker login --username AWS --password-stdin "${ECR_REGISTRY}"
            docker tag "${DOCKER_IMAGE_LOCAL}" "${fullImage}"
            docker push "${fullImage}"
            echo "PUSHED_IMAGE=${fullImage}" > pushed_image.env
          """
        }
      }
    }

    stage('Update Task Definition (set image)') {
      steps {
        sh """
          set -euo pipefail

          python3 - <<'PY'
import json

task_def_file = "${params.TASK_DEF_JSON}"
container_name = "test-app"

with open("pushed_image.env", "r") as f:
    pushed_image = f.read().strip().split("=", 1)[1]

with open(task_def_file, "r") as f:
    data = json.load(f)

found = False
for c in data.get("containerDefinitions", []):
    if c.get("name") == container_name:
        c["image"] = pushed_image
        found = True

if not found:
    raise SystemExit(f"Container name '{container_name}' not found in {task_def_file}")

with open(task_def_file, "w") as f:
    json.dump(data, f, indent=2)

print(f"Updated image to {pushed_image}")
PY

          echo 'Updated image lines:'
          grep -n '"image"' "${params.TASK_DEF_JSON}" | head -n 10
        """
      }
    }

    stage('Register Task Definition') {
      steps {
        script {
          def taskDefArn = sh(
            script: """
              set -euo pipefail
              aws ecs register-task-definition \
                --region ${AWS_REGION} \
                --cli-input-json file://${params.TASK_DEF_JSON} \
                --query 'taskDefinition.taskDefinitionArn' \
                --output text
            """,
            returnStdout: true
          ).trim()

          echo "Task Definition ARN: ${taskDefArn}"

          sh """
            set -euo pipefail

            python3 - <<'PY'
import json

task_def_arn = "${taskDefArn}"

for path in ["${params.CREATE_SERVICE_FILE}", "${params.UPDATE_SERVICE_FILE}"]:
    with open(path, "r") as f:
        data = json.load(f)

    data["taskDefinition"] = task_def_arn

    with open(path, "w") as f:
        json.dump(data, f, indent=2)

    print(f"Updated {path} with taskDefinition={task_def_arn}")
PY
          """
        }
      }
    }

    stage('Stop running tasks (only if service exists)') {
      steps {
        script {
          def status = sh(
            script: """
              set -euo pipefail
              aws ecs describe-services --region ${AWS_REGION} --cluster ${params.ECS_CLUSTER_NAME} --services ${params.SERVICE_NAME} \
                --query "services[0].status" --output text 2>/dev/null || echo MISSING
            """,
            returnStdout: true
          ).trim()

          if (status == "ACTIVE") {
            sh """
              set -euo pipefail
              tasks=\$(aws ecs list-tasks --region ${AWS_REGION} --cluster ${params.ECS_CLUSTER_NAME} --service-name ${params.SERVICE_NAME} \
                --desired-status RUNNING --query taskArns --output text || true)
              for task in \$tasks; do
                [ -z "\$task" ] && continue
                aws ecs stop-task --region ${AWS_REGION} --cluster ${params.ECS_CLUSTER_NAME} --task \$task
              done
            """
          } else {
            echo "Service not ACTIVE (status=${status}). Skipping stop tasks."
          }
        }
      }
    }

    stage('Create or Update ECS Service') {
      steps {
        script {
          def status = sh(
            script: """
              set -euo pipefail
              aws ecs describe-services --region ${AWS_REGION} --cluster ${params.ECS_CLUSTER_NAME} --services ${params.SERVICE_NAME} \
                --query "services[0].status" --output text 2>/dev/null || echo MISSING
            """,
            returnStdout: true
          ).trim()

          if (status == "ACTIVE") {
            sh """
              set -euo pipefail
              echo "Updating service..."
              aws ecs update-service --region ${AWS_REGION} --cli-input-json file://${params.UPDATE_SERVICE_FILE}
            """
          } else {
            sh """
              set -euo pipefail
              echo "Creating service..."
              aws ecs create-service --region ${AWS_REGION} --cli-input-json file://${params.CREATE_SERVICE_FILE}
            """
          }
        }
      }
    }
  }
}
